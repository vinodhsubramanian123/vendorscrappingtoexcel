{
  "name": "booktoskill-hpe-oca-scraper",
  "version": "1.1.0",
  "description": "HPE OCA Solution & Product Catalog Intelligence Pipeline",
  "main": "scripts/scrape_oca_solution.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node scripts/verify_all.js",
    "scrape": "node scripts/scrape_oca_solution.js",
    "scrape:storage": "node scripts/scrape_oca_storage_solution.js",
    "raw": "node scripts/scrape_oca.js",
    "expand": "node scripts/expand_and_rescrape.js",
    "build": "node scripts/build_catalog.js",
    "generate": "node scripts/generate_xlsx.js",
    "verify": "node scripts/verify_excel_tally.js",
    "audit": "node scripts/test_pipeline_evals.js",
    "audit:all": "node scripts/verify_all.js",
    "download:qs": "node scripts/download_quickspecs_pdf.js",
    "rebuild": "node scripts/rebuild_all.js",
    "eval:boq": "node scripts/eval_boq.js",
    "registry:sync": "node scripts/lib/sync_registry.js",
    "sync:knowledge": "node scripts/lib/knowledge_sync.js",
    "status": "node scripts/observability_status.js",
    "inspect:session": "node scripts/inspect_oca_session.js",
    "inspect:clic": "node scripts/visual_clic_inspector.js",
    "parse:clic": "node scripts/parse_clic_modal.js",
    "test:aspects": "node scripts/test_all_aspects.js",
    "test:offline": "node tests/test_offline_pipeline.js",
    "eval:multi": "node scripts/eval_multi_boq.js",
    "probe:cdp": "node scripts/cli_tools.js probe:cdp",
    "scrape:auto": "node scripts/cli_tools.js scrape:auto",
    "resolve:ambiguity": "node scripts/cli_tools.js resolve:ambiguity",
    "trace:view": "node scripts/cli_tools.js trace:view",
    "test:all": "node tests/test_end_to_end_scenarios.js && node tests/test_conflict_graph.js && node tests/test_offline_pipeline.js && node scripts/test_all_aspects.js && node scripts/verify_all.js",
    "test:clic": "node scripts/test_live_clic.js",
    "dashboard": "npx -y concurrently \"node dashboard/server.cjs\" \"npm --prefix dashboard run dev\"",
    "demo:qs": "node scripts/demo_qs_vs_menu_cdp.js",
    "demo:live": "node scripts/live_visual_demo_cdp.js"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "xlsx-js-style": "^1.2.0"
  }
}
